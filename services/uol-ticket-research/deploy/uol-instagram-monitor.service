[Unit]
Description=Instagram Stories complement for the Clube UOL bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uol-instagram-monitor
Group=uol-instagram-monitor
WorkingDirectory=/opt/uol-instagram-monitor
ExecStart=/usr/bin/python3 -B monitor.py --data-dir /var/lib/uol-instagram-monitor --config-file /var/lib/uol-instagram-monitor/config.json
Restart=on-failure
RestartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/uol-instagram-monitor
MemoryHigh=48M
MemoryMax=64M
TasksMax=8
LimitCORE=0

[Install]
WantedBy=multi-user.target
