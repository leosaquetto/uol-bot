[Unit]
Description=Dedicated Instagram Web Push receiver for Clube UOL
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uol-instagram-monitor
Group=uol-instagram-monitor
WorkingDirectory=/opt/uol-instagram-monitor
ExecStart=/usr/local/bin/node /opt/uol-instagram-monitor/push/receiver.mjs /var/lib/uol-instagram-monitor/push-registration.json
Restart=on-failure
RestartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/uol-instagram-monitor
MemoryHigh=64M
MemoryMax=96M
TasksMax=12
LimitCORE=0

[Install]
WantedBy=multi-user.target
