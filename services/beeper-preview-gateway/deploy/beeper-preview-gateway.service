[Unit]
Description=Beeper preview gateway
After=network-online.target beeper-server.service
Wants=network-online.target

[Service]
Type=simple
User=beeper
Group=beeper
WorkingDirectory=/opt/beeper-preview-gateway
EnvironmentFile=/etc/beeper-preview-gateway.env
ExecStart=/usr/local/bin/node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/beeper-preview-gateway

[Install]
WantedBy=multi-user.target
