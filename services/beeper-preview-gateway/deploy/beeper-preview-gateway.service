[Unit]
Description=Beeper preview gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=beeper
Group=beeper
SupplementaryGroups=ubuntu
WorkingDirectory=/opt/beeper-preview-gateway
EnvironmentFile=/etc/beeper-preview-gateway.env
ExecStart=/usr/local/bin/node src/server.js
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/beeper-preview-gateway

[Install]
WantedBy=multi-user.target
