{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uol-telegram-shadow-pilot",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "WORKER_VERSION"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "DELIVERY_MODE": "live",
    "ALARM_INTERVAL_SECONDS": "15",
    "MAIN_IMAGE_WAIT_SECONDS": "60",
    "MAINTENANCE_INTERVAL_SECONDS": "60",
    "HTML_RECONCILIATION_INTERVAL_SECONDS": "60",
    "DETAIL_BATCH_SIZE": "4",
    "DELIVERY_BATCH_SIZE": "4",
    "DELIVERY_CONCURRENCY": "6",
    "DELIVERY_MAX_ATTEMPTS": "10",
    "DELIVERY_IN_FLIGHT_STALE_SECONDS": "30",
    "MAIN_AMBIGUOUS_RETRY_SECONDS": "30",
    "CANAL2_DELIVERY_ENABLED": "true",
    "DISCORD_DELIVERY_ENABLED": "true",
    "BEEPER_DELIVERY_ENABLED": "true",
    "OPS_TICKET_GRACE_MINUTES": "3",
    "OPS_ALERT_COOLDOWN_MINUTES": "360",
    "OPS_ALERT_RETRY_SECONDS": "60",
    "OPS_MAIN_DELIVERY_GRACE_SECONDS": "45",
    "IMAGE_CIRCUIT_FAILURE_THRESHOLD": "3",
    "IMAGE_CIRCUIT_COOLDOWN_MINUTES": "10",
    "OFFER_RETENTION_DAYS": "30",
    "MAX_STATE_OFFERS": "300",
    "MIN_HEALTHY_LISTING_OFFERS": "5",
    "MAX_VALID_FROM_AGE_HOURS": "36",
    "RECENT_RESEND_BLOCK_HOURS": "168",
    "REUSED_ID_COOLDOWN_HOURS": "168",
    "OFFER_LAST_SEEN_TOUCH_MINUTES": "15",
    "DURABLE_OBJECT_ROWS_READ_DAILY_LIMIT": "5000000",
    "SOLD_OUT_LOOKBACK_DAYS": "3",
    "SOLD_OUT_MIN_MISSES": "2",
    "SOLD_OUT_MIN_ABSENCE_MINUTES": "15",
    "TICKET_SOLD_OUT_PROBE_DELAY_SECONDS": "60",
    "TICKET_SOLD_OUT_PROBE_DAILY_LIMIT": "256",
    "TICKET_SOLD_OUT_PROBES_PER_SCAN": "1",
    "TICKET_SOLD_OUT_PROBE_MAX_ATTEMPTS": "2",
    "PUBLIC_BASE_URL": "https://uol-telegram-shadow-pilot.leosaquetto.workers.dev"
  },
  "secrets": {
    "required": [
      "ADMIN_TOKEN",
      "UOL_API_AUTHORIZATION",
      "TELEGRAM_TOKEN",
      "TELEGRAM_CHAT_ID",
      "CANAL2_ID",
      "GRUPO_COMENTARIO_ID",
      "OPS_TELEGRAM_CHAT_ID",
      "TELEGRAM_WEBHOOK_SECRET",
      "DISCORD_WEBHOOK_URL",
      "DISCORD_IMAGE_CACHE_WEBHOOK_URL"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "UOL_TELEGRAM_SHADOW",
        "class_name": "UolTelegramShadow"
      },
      {
        "name": "UOL_TELEGRAM_MAINTENANCE",
        "class_name": "UolTelegramMaintenance"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UolTelegramShadow"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["UolTelegramMaintenance"]
    }
  ]
}
