{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uol-telegram-shadow-pilot",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "DELIVERY_MODE": "live",
    "ALARM_INTERVAL_SECONDS": "15",
    "DETAIL_BATCH_SIZE": "4",
    "DELIVERY_BATCH_SIZE": "4",
    "DELIVERY_MAX_ATTEMPTS": "10",
    "OPS_TICKET_GRACE_MINUTES": "3",
    "OPS_ALERT_COOLDOWN_MINUTES": "360",
    "IMAGE_CIRCUIT_FAILURE_THRESHOLD": "3",
    "IMAGE_CIRCUIT_COOLDOWN_MINUTES": "10",
    "AUTH_REFRESH_BEFORE_MINUTES": "60",
    "AUTH_REFRESH_COOLDOWN_MINUTES": "360",
    "OFFER_RETENTION_DAYS": "30",
    "MAX_STATE_OFFERS": "300",
    "MIN_HEALTHY_LISTING_OFFERS": "5",
    "MAX_VALID_FROM_AGE_HOURS": "36",
    "RECENT_RESEND_BLOCK_HOURS": "168",
    "SOLD_OUT_LOOKBACK_DAYS": "3",
    "SOLD_OUT_MIN_MISSES": "2",
    "SOLD_OUT_MIN_ABSENCE_MINUTES": "15",
    "GRUPO_COMENTARIO_ID": "-1003802235343",
    "OPS_TELEGRAM_CHAT_ID": "-1003802235343",
    "PUBLIC_BASE_URL": "https://uol-telegram-shadow-pilot.leosaquetto.workers.dev"
  },
  "browser": {
    "binding": "UOL_BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "UOL_TELEGRAM_SHADOW",
        "class_name": "UolTelegramShadow"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UolTelegramShadow"]
    }
  ]
}
