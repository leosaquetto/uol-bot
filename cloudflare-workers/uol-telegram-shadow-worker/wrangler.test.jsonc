{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uol-telegram-shadow-worker-test",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "WORKER_VERSION"
  },
  "vars": {
    "DELIVERY_MODE": "shadow",
    "INSTAGRAM_WAKE_CLIENTS": "{\"test\":\"bf04262df449dc4ddcc2af350a7e008e702f0455fcbf9bf13aecd8d66bfd30aa\"}",
    "HUNTER_INTAKE_CLIENTS": "{\"test\":\"d03b39910f9f37a87a62e00894659a804e277cdff02c470c6b9396eed5d393b7\"}",
    "HUNTER_INSTAGRAM_SESSION": "{\"user_agent\":\"synthetic-hunter-browser\",\"cookies\":[{\"name\":\"sessionid\",\"value\":\"synthetic-hunter-private-session\",\"domain\":\".instagram.com\"},{\"name\":\"csrftoken\",\"value\":\"synthetic-hunter-csrf\",\"domain\":\".instagram.com\"},{\"name\":\"foreign\",\"value\":\"must-not-leak\",\"domain\":\"example.test\"}],\"headers\":{\"accept-language\":\"pt-BR\",\"Authorization\":\"must-not-leak\"},\"arbitrary\":\"must-not-leak\"}",
    "HUNTER_UOL_ACCOUNTS": "{\"leosaquetto\":{\"identityDigest\":\"1111111111111111111111111111111111111111111111111111111111111111\",\"cookies\":[{\"name\":\"SESS\",\"value\":\"synthetic-uol-leo-only\",\"domain\":\".uol.com.br\",\"path\":\"/\",\"secure\":true,\"httpOnly\":true,\"hostOnly\":false,\"expires\":-1}]},\"gaoriel\":{\"identityDigest\":\"2222222222222222222222222222222222222222222222222222222222222222\",\"cookies\":[{\"name\":\"SESS\",\"value\":\"synthetic-uol-gab-only\",\"domain\":\".uol.com.br\",\"path\":\"/\",\"secure\":true,\"hostOnly\":false,\"expires\":-1}]}}",
    "STORAGE_USAGE_GLOBAL_GUARD_ENABLED": "false",
    "STORAGE_USAGE_INGEST_TOKEN": "vitest-storage-usage-token-not-a-secret",
    "ALARM_INTERVAL_SECONDS": "10",
    "MAINTENANCE_INTERVAL_SECONDS": "10",
    "DELIVERY_IN_FLIGHT_STALE_SECONDS": "30",
    "MAIN_AMBIGUOUS_RETRY_SECONDS": "30",
    "ADMIN_TOKEN": "vitest-admin-token-not-a-secret",
    "TELEGRAM_WEBHOOK_SECRET": "vitest-webhook-token-not-a-secret",
    "TELEGRAM_CHAT_ID": "-100111",
    "GRUPO_COMENTARIO_ID": "-100222"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "UOL_TELEGRAM_SHADOW",
        "class_name": "UolTelegramShadow"
      },
      {
        "name": "UOL_TELEGRAM_MAINTENANCE",
        "class_name": "UolTelegramMaintenance"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UolTelegramShadow"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["UolTelegramMaintenance"]
    }
  ]
}
